OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=3
OPENROUTER_MAX_PROMPT_CHARS=14000

# TLS for OpenRouter (corporate SSL inspection)
# Prefer mounting a corporate CA: OPENROUTER_CA_BUNDLE=/path/to/ca.pem
OPENROUTER_VERIFY_SSL=false
OPENROUTER_CA_BUNDLE=

# TLS for AWS CLI (EKS exec auth via aws eks get-token)
# Prefer mounting a corporate CA: AWS_CA_BUNDLE=/path/to/ca.pem
AWS_VERIFY_SSL=true
AWS_CA_BUNDLE=
