OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=3
OPENROUTER_MAX_PROMPT_CHARS=14000

# Default AI provider for RCA: openrouter or gitlab_duo
AI_PROVIDER=openrouter

# GitLab Duo Code Suggestions (alternative to OpenRouter)
GITLABDUO_TOKEN=your_gitlab_personal_access_token_here
GITLABDUO_API_URL=https://gitlab.com/api/v4/code_suggestions/completions
GITLABDUO_MODEL=gitlab-duo
GITLABDUO_TIMEOUT_SECONDS=120
GITLABDUO_MAX_RETRIES=3
GITLABDUO_MAX_PROMPT_CHARS=14000
GITLABDUO_VERIFY_SSL=true
GITLABDUO_CA_BUNDLE=

# TLS for OpenRouter (corporate SSL inspection)
# Prefer mounting a corporate CA: OPENROUTER_CA_BUNDLE=/path/to/ca.pem
OPENROUTER_VERIFY_SSL=false
OPENROUTER_CA_BUNDLE=

# TLS for AWS CLI (EKS exec auth via aws eks get-token)
# Prefer mounting a corporate CA: AWS_CA_BUNDLE=/path/to/ca.pem
AWS_VERIFY_SSL=true
AWS_CA_BUNDLE=

# Optional AI context files (paths relative to backend directory /app in Docker).
# Set *_ENABLED=true only for files you keep under backend/context/.
DEPLOYMENT_CONTEXT_ENABLED=false
# DEPLOYMENT_CONTEXT=inline project pipeline description
DEPLOYMENT_CONTEXT_FILE=context/deployment-context.txt

RCA_GUARDRAILS_ENABLED=false
# RCA_GUARDRAILS=inline guardrails text
RCA_GUARDRAILS_FILE=context/rca-guardrails.txt

RUNBOOK_CONTEXT_ENABLED=false
# RUNBOOK_CONTEXT=inline runbook references
RUNBOOK_CONTEXT_FILE=context/runbook-context.txt
